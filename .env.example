# Discord 봇 토큰 (필수)
TOKEN=your_discord_bot_token_here

# TTS를 지원할 음성 채널 ID들 (쉼표로 구분, 선택)
# 이 채널들의 채팅에서 메시지를 입력하면 해당 채널에서 TTS 재생
TTS_VOICE_CHANNEL_IDS=123456789012345678,987654321098765432

# TTS 언어 설정 (기본값: ko)
# 지원 언어: ko (한국어), en (영어), ja (일본어) 등
TTS_LANG=ko

# TTS 로케일 (선택, 기본값은 TTS_LANG에서 자동 유도: ko -> ko-KR)
# 다국어 음성이 어떤 언어로 읽을지 결정합니다
# TTS_LOCALE=ko-KR
